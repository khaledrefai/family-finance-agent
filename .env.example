# Copy to .env and change the values. .env is git-ignored.
POSTGRES_PASSWORD=change-me
# 32+ random characters. Generate one with:  openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# Port the web app is published on
WEB_PORT=3000
# The Planner's Claude step. Leave the key empty (or set AGENTS_LLM=off) and the rule-based answers are used,
# which is what the demo recording should use if the network is unsure.
ANTHROPIC_API_KEY=
# auto = use Claude when a key is set; on = always try; off = never
AGENTS_LLM=auto
AGENTS_LLM_MODEL=claude-opus-5-5
# SerpAPI key for web searches (live product and gold prices). Optional; nothing reads it yet.
SERPAPI_KEY=

# Week 5 notifications (all optional).
# Email alerts to parents (bills, card bills, budgets, Sunday's plan). Empty SMTP_HOST = no email.
# Port 587 uses STARTTLS; for port 465 also set SMTP_SSL=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Where the app is opened, for the link in emails, e.g. http://203.0.113.10:3000
APP_PUBLIC_URL=
# Web push keys. Leave empty: the core makes a pair on first start and keeps it in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How push services can reach you: mailto:you@example.com (optional)
PUSH_CONTACT=
