# Copy to .env and change the values. .env is git-ignored.
POSTGRES_PASSWORD=change-me
# 32+ random characters. Generate one with:  openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# Port the web app is published on
WEB_PORT=3000
# HTTPS on a real domain (VPS only). Set both and ./deploy.sh also starts Caddy on ports 80 and 443,
# which gets the certificate by itself. Leave empty on your own computer.
DOMAIN=
COMPOSE_PROFILES=
# The Planner's Claude step. Leave the key empty (or set AGENTS_LLM=off) and the rule-based answers are used,
# which is what the demo recording should use if the network is unsure.
ANTHROPIC_API_KEY=
# auto = use Claude when a key is set; on = always try; off = never
AGENTS_LLM=auto
AGENTS_LLM_MODEL=claude-opus-5-5
# Price search (week 6). The SerpApi key for live Google Shopping prices in the UAE. Optional: without it the
# app uses the 24 hour cache and then its saved price list.
SERPAPI_KEY=
# live = cache (24 h), then a live search, then the saved list; cache = cache (any age), then the saved list
# (use this while recording, after ./deploy.sh prewarm); off = the saved list only.
SEARCH_LIVE=live
# Each comparison re-checks its top offers with one narrower search each. 0 = no re-check (saves searches).
PRICE_VERIFY_TOP=3

# Week 5 notifications (all optional).
# Email alerts to parents (bills, card bills, budgets, Sunday's plan). Empty SMTP_HOST = no email.
# Port 587 uses STARTTLS; for port 465 also set SMTP_SSL=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Where the app is opened, for the link in emails, e.g. https://family-finance-coach.com
APP_PUBLIC_URL=
# Web push keys. Leave empty: the core makes a pair on first start and keeps it in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How push services can reach you: mailto:you@example.com (optional)
PUSH_CONTACT=
