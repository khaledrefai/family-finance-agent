# HTTPS in front of the web app. Caddy gets and renews the Let's Encrypt certificate by itself;
# it only needs DNS for the domain (and www) to point at this server and ports 80 and 443 open.
# DOMAIN comes from .env, e.g. DOMAIN=family-finance-coach.com

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	# flush_interval -1 sends live updates (server-sent events) straight away instead of buffering them.
	reverse_proxy web:3000 {
		flush_interval -1
	}
}
